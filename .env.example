# ==============================================================================
# StrataFlow Protocol - Backend Environment Variables
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# Stellar Network & RPC Settings
STELLAR_NETWORK=TESTNET
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract Addresses (Soroban v21 C... StrKey format)
STRATAFLOW_CONTRACT_ID=CDXVD3AA43SE2D52ZBJSH3RDKAPOYG6OCDAZGSQD6M5TCBQIG3HTLY6J
NATIVE_TOKEN_CONTRACT=CDLZ73VU7Y4Z45ETK26QU62NDXQJ2277NY2Y57C2ZFU7SS7M6HWT7G4H
USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYJLPU6QXOC4Z4V75N2YSRN7RCRD66N6E2

# Cryptographic Authentication (SEP-10 Server Secret Seed S... format)
# NOTE: Replace with your own funded Stellar testnet keypair seed
SERVER_SECRET_KEY=SCZANGBA5YHTNYVVV4C3U252E2B6P6IRKDIOINZCAHSKV27QIN2YQZAA
JWT_SECRET=strataflow-production-jwt-super-secret-key-32chars!

# Database Persistence (PostgreSQL connection string)
# Leave commented or empty to run with resilient in-memory fallback
# DATABASE_URL=postgresql://strataflow_user:secure_password@localhost:5432/strataflow_db?schema=public

# Abuse Prevention & Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
